{
  "name": "gen-password",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "globalConcurrency": 32,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "watch": "turbo watch verify",
    "prepare": "bunx lefthook install",
    "dev": "turbo dev --ui=tui",
    "format": "turbo format",
    "scan": "sg scan -r",
    "check:modules": "bunx node-modules-inspector",
    "lint": "turbo lint",
    "test": "turbo test",
    "build": "turbo build",
    "verify": "turbo verify"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "node-modules-inspector": "^2.1.3",
    "rimraf": "^6.1.3",
    "taze": "^19.14.1",
    "turbo": "^2.9.17"
  }
}
